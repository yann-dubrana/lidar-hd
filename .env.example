# Copy to .env and fill in. .env is gitignored; never commit real keys.

# --- MinIO (only needed for the upload stage) ---
MINIO_ENDPOINT=storage.optimaize.fr
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lidar-hd
MINIO_PREFIX=lidar-hd
# Set to false for a plain-HTTP MinIO (local dev).
MINIO_SECURE=true

# --- where downloads and derived data land ---
LIDARHD_DATA=C:\lidar\data
